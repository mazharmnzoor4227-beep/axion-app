<?xml version="1.0" encoding="utf-8"?>
<!-- v0.5.2 (Android 12+): nothing of Axion's goes to Google Drive backup or a phone-to-phone transfer:
     keys, tokens, chats, projects and Linux all stay on this phone. Move keys with Settings → Export / import keys. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
